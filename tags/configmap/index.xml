&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-bash" data-lang="bash">&lt;span class="line">&lt;span class="cl">k get cm,secret,sa,role,rolebinding -n &amp;lt;ns&amp;gt;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">k describe cm app-config -n &amp;lt;ns&amp;gt;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">k describe secret app-secret -n &amp;lt;ns&amp;gt;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">k get pod &amp;lt;pod&amp;gt; -n &amp;lt;ns&amp;gt; -o yaml &lt;span class="p">|&lt;/span> grep -A20 -E &lt;span class="s1">&amp;#39;env|volume|securityContext|serviceAccountName&amp;#39;&lt;/span>
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">k auth can-i &amp;lt;verb&amp;gt; &amp;lt;resource&amp;gt; -n &amp;lt;ns&amp;gt; --as&lt;span class="o">=&lt;/span>&amp;lt;user-or-sa&amp;gt;
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
