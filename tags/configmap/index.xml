&lt;pre tabindex="0" class="chroma">&lt;code>&lt;span class="lnt">1
&lt;/span>&lt;span class="lnt">2
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-bash" data-lang="bash">&lt;span class="line">&lt;span class="cl">k create role pod-reader -n security --verb&lt;span class="o">=&lt;/span>get,list,watch --resource&lt;span class="o">=&lt;/span>pods
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">k create rolebinding read-pods -n security --role&lt;span class="o">=&lt;/span>pod-reader --serviceaccount&lt;span class="o">=&lt;/span>security:app-sa
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>集群级资源或所有命名空间授权，用 &lt;code>ClusterRole&lt;/code> 和 &lt;code>ClusterRoleBinding&lt;/code>：&lt;/p>
&lt;div class="highlight">&lt;div class="chroma">
&lt;table class="lntable">&lt;tr>&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code>&lt;span class="lnt">1
&lt;/span>&lt;span class="lnt">2
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-bash" data-lang="bash">&lt;span class="line">&lt;span class="cl">k create clusterrole pod-reader --verb&lt;span class="o">=&lt;/span>get,list,watch --resource&lt;span class="o">=&lt;/span>pods
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">k create clusterrolebinding read-pods --clusterrole&lt;span class="o">=&lt;/span>pod-reader --user&lt;span class="o">=&lt;/span>jane
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>检查权限：&lt;/p>
&lt;div class="highlight">&lt;div class="chroma">
&lt;table class="lntable">&lt;tr>&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code>&lt;span class="lnt">1
&lt;/span>&lt;span class="lnt">2
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-bash" data-lang="bash">&lt;span class="line">&lt;span class="cl">k auth can-i list pods -n security --as&lt;span class="o">=&lt;/span>system:serviceaccount:security:app-sa
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">k auth can-i get pods --as&lt;span class="o">=&lt;/span>jane
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
